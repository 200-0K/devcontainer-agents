// Merge into your .devcontainer/devcontainer.json.
// If you already have init/postCreate/postAttach commands, move their bodies into
// .devcontainer/project-setup.sh (etc.) and chain them as shown.
{
  "initializeCommand": "./.devcontainer/agents.sh init",
  "postCreateCommand": "./.devcontainer/agents.sh install && ./.devcontainer/project-setup.sh",
  "postAttachCommand": "./.devcontainer/agents.sh sync",

  "containerEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
    // Per-project agent toggles. Default is on; uncomment to disable.
    // "ENABLE_CLAUDE":   "0"
    // "ENABLE_OPENCODE": "0"
    // "ENABLE_GEMINI":   "0"
    // "ENABLE_CODEX":    "0"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "Anthropic.claude-code"
      ]
    }
  }
}
