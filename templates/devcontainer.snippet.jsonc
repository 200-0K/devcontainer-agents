// Merge into your .devcontainer/devcontainer.json.
// If you already have init/postCreate/postAttach commands, chain the agents.sh
// calls with your existing ones (e.g. "./.devcontainer/agents.sh install && <yours>").
{
  "initializeCommand": "./.devcontainer/agents.sh init",
  "postCreateCommand": "./.devcontainer/agents.sh install",
  "postAttachCommand": "./.devcontainer/agents.sh sync"
}
